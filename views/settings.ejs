<% var title = t('settings.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <h1 class="page-title"><%= t('settings.title') %></h1>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.target_heading') %></h2>
    <p class="help-text"><%= t('settings.target_help') %></p>
    <form method="post" action="/settings/target-duration" style="display:flex; gap:0.6em; align-items:center;">
      <input type="number" name="target_seconds" min="1" max="3600" value="<%= targetSeconds %>" style="width:7em;">
      <button type="submit"><%= t('settings.save') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.reminder_heading') %></h2>
    <p class="help-text"><%= t('settings.reminder_help') %></p>
    <form method="post" action="/settings/reminder" style="display:flex; gap:0.6em; align-items:center; flex-wrap:wrap;">
      <label style="display:flex; gap:0.4em; align-items:center; font-size:0.9em; margin:0;">
        <input type="checkbox" name="enabled" <%= reminderEnabled ? 'checked' : '' %>>
        <%= t('settings.reminder_enabled_label') %>
      </label>
      <input type="time" name="time" value="<%= reminderTime %>">
      <button type="submit"><%= t('settings.save') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.notifications_heading') %></h2>
    <p class="help-text"><%= t('settings.notifications_help') %></p>
    <% if (testResult === 'ok') { %><div class="success"><%= t('settings.test_ok') %></div><% } %>
    <% if (testResult === 'error') { %><div class="error"><%= t('settings.test_error') %></div><% } %>
    <form method="post" action="/settings/notifications" class="stacked">
      <div class="radio-row">
        <% reminderMethods.forEach(function(m) { %>
        <label><input type="radio" name="method" value="<%= m %>" <%= reminderMethod === m ? 'checked' : '' %>> <%= t('settings.method_' + m) %></label>
        <% }) %>
      </div>

      <label><%= t('settings.ntfy_base_url') %></label>
      <input type="text" name="ntfy_base_url" value="<%= ntfyBaseUrl %>" placeholder="https://ntfy.sh">
      <label><%= t('settings.ntfy_topic') %></label>
      <input type="text" name="ntfy_topic" value="<%= ntfyTopic || '' %>" placeholder="coldshowers-yourname">
      <label><%= t('settings.ntfy_token') %></label>
      <input type="password" name="ntfy_token" value="<%= ntfyToken || '' %>" placeholder="<%= t('settings.optional') %>">

      <label><%= t('settings.telegram_bot_token') %></label>
      <input type="password" name="telegram_bot_token" value="<%= telegramBotToken || '' %>">
      <label><%= t('settings.telegram_chat_id') %></label>
      <input type="text" name="telegram_chat_id" value="<%= telegramChatId || '' %>">

      <p><button type="submit"><%= t('settings.save') %></button></p>
    </form>
    <form method="post" action="/settings/notifications/test">
      <button type="submit" class="secondary"><%= t('settings.test_button') %></button>
    </form>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.push_heading') %></h2>
    <p class="help-text"><%= t('settings.push_help') %></p>
    <div id="push-status" style="margin: 0.6em 0; font-size: 0.9em; color: var(--text-dim);"></div>
    <button type="button" id="push-toggle" class="secondary"></button>
  </div>

  <div class="card">
    <h2 style="margin-top:0"><%= t('settings.language_heading') %></h2>
    <form method="post" action="/settings/locale" style="display:flex; gap:0.6em; flex-wrap:wrap; align-items:center;">
      <select name="locale">
        <option value="" <%= !storedLocale ? 'selected' : '' %>><%= t('settings.language_auto') %></option>
        <% SUPPORTED_LOCALES.forEach(function(loc) { %>
        <option value="<%= loc %>" <%= storedLocale === loc ? 'selected' : '' %>><%= loc === 'nl' ? 'Nederlands' : 'English' %></option>
        <% }) %>
      </select>
      <button type="submit"><%= t('settings.save') %></button>
    </form>
  </div>
</main>
<script>
  const VAPID_PUBLIC_KEY = <%- JSON.stringify(vapidPublicKey) %>;
  const S = <%- JSON.stringify({
      notSupported: t('settings.push_not_supported'), enable: t('settings.push_enable'),
      disable: t('settings.push_disable'), enabled: t('settings.push_enabled'), denied: t('settings.push_denied'),
  }) %>;
  let subscribed = <%- pushSubscribed ? 'true' : 'false' %>;

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64);
    return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
  }

  const statusEl = document.getElementById('push-status');
  const toggleEl = document.getElementById('push-toggle');

  function renderState() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !VAPID_PUBLIC_KEY) {
      statusEl.textContent = S.notSupported;
      toggleEl.style.display = 'none';
      return;
    }
    if (Notification.permission === 'denied') {
      statusEl.textContent = S.denied;
      toggleEl.style.display = 'none';
      return;
    }
    statusEl.textContent = subscribed ? S.enabled : '';
    toggleEl.textContent = subscribed ? S.disable : S.enable;
  }

  async function enablePush() {
    const registration = await navigator.serviceWorker.register('/sw.js');
    const permission = await Notification.requestPermission();
    if (permission !== 'granted') { renderState(); return; }
    const sub = await registration.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
    });
    await fetch('/push-subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(sub.toJSON()),
    });
    subscribed = true;
    renderState();
  }

  async function disablePush() {
    const registration = await navigator.serviceWorker.getRegistration('/sw.js');
    const sub = await registration?.pushManager.getSubscription();
    if (sub) {
      await fetch('/push-unsubscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: sub.endpoint }),
      });
      await sub.unsubscribe();
    }
    subscribed = false;
    renderState();
  }

  toggleEl.onclick = () => (subscribed ? disablePush() : enablePush());
  renderState();
</script>
</body>
</html>
