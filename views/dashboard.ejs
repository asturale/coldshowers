<% var title = t('dashboard.title') %>
<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main>
  <h1 class="page-title"><%= t('dashboard.title') %></h1>
  <p class="page-sub"><%= t('dashboard.target_label', { duration: Math.floor(targetSeconds/60) + ':' + String(targetSeconds%60).padStart(2,'0') }) %></p>

  <div class="card">
    <div class="timer-mode-toggle">
      <button type="button" id="modeStopwatchBtn" class="mode-btn active"><%= t('dashboard.mode_stopwatch') %></button>
      <button type="button" id="modeCountdownBtn" class="mode-btn"><%= t('dashboard.mode_countdown') %></button>
    </div>
    <div class="timer-phase-label" id="timerPhaseLabel"></div>
    <div class="timer-display" id="timerDisplay">00:00</div>
    <div class="timer-actions">
      <button type="button" id="timerStartBtn"><%= t('dashboard.timer_start') %></button>
      <button type="button" id="timerStopBtn" class="secondary" disabled><%= t('dashboard.timer_stop') %></button>
    </div>
    <div class="quick-log">
      <form method="post" action="/log">
        <input type="hidden" name="duration_seconds" value="<%= targetSeconds %>">
        <button type="submit" class="secondary"><%= t('dashboard.quick_log', { duration: Math.floor(targetSeconds/60) + ':' + String(targetSeconds%60).padStart(2,'0') }) %></button>
      </form>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat-tile">
      <div class="value"><%= currentStreak %></div>
      <div class="label"><%= t('dashboard.current_streak') %></div>
    </div>
    <div class="stat-tile">
      <div class="value"><%= longestStreak %></div>
      <div class="label"><%= t('dashboard.longest_streak') %></div>
    </div>
    <div class="stat-tile">
      <div class="value"><%= totalCount %></div>
      <div class="label"><%= t('dashboard.total_showers') %></div>
    </div>
  </div>

  <% if (chart.length > 0) { %>
  <div class="card">
    <h2 style="margin-top:0; font-size:1.1em;"><%= t('dashboard.chart_heading') %></h2>
    <canvas id="progressChart" height="200"></canvas>
  </div>
  <% } %>

  <% if (showers.length === 0) { %>
  <div class="empty-state card"><%= t('dashboard.empty') %></div>
  <% } else { %>
  <div class="card">
    <h2 style="margin-top:0; font-size:1.1em;"><%= t('dashboard.history_heading') %></h2>
    <table>
      <tr><th><%= t('dashboard.col_date') %></th><th><%= t('dashboard.col_duration') %></th><th></th></tr>
      <% showers.forEach(function(s) { %>
      <tr>
        <td><%= new Date(s.started_at).toLocaleString(dateLocale) %></td>
        <td class="num"><%= Math.floor(s.duration_seconds/60) %>:<%= String(s.duration_seconds%60).padStart(2,'0') %></td>
        <td style="text-align:right">
          <form method="post" action="/showers/<%= s.id %>/delete" onsubmit="return confirm('<%= t('dashboard.delete_confirm') %>')" style="margin:0;">
            <button type="submit" class="danger" style="padding:0.3em 0.7em; font-size:0.8em;"><%= t('dashboard.delete') %></button>
          </form>
        </td>
      </tr>
      <% }) %>
    </table>
  </div>
  <% } %>
</main>

<% if (chart.length > 0) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<script>
  const chartData = <%- JSON.stringify(chart) %>;
  const ctx = document.getElementById('progressChart');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: chartData.map((d) => d.date),
      datasets: [
        {
          label: <%- JSON.stringify(t('dashboard.chart_duration_label')) %>,
          data: chartData.map((d) => d.durationSeconds),
          borderColor: '#38bdf8',
          backgroundColor: 'rgba(56,189,248,0.15)',
          tension: 0.25,
          fill: true,
        },
        {
          label: <%- JSON.stringify(t('dashboard.chart_target_label')) %>,
          data: chartData.map((d) => d.targetSeconds),
          borderColor: '#5f7891',
          borderDash: [4, 4],
          pointRadius: 0,
          fill: false,
        },
      ],
    },
    options: {
      responsive: true,
      scales: {
        x: { ticks: { color: '#93acc4' }, grid: { color: '#1f3346' } },
        y: { ticks: { color: '#93acc4' }, grid: { color: '#1f3346' } },
      },
      plugins: { legend: { labels: { color: '#e7f1fb' } } },
    },
  });
</script>
<% } %>

<script>
  const TARGET_SECONDS = <%- JSON.stringify(targetSeconds) %>;
  const DONE_TEXT = <%- JSON.stringify(t('dashboard.countdown_done')) %>;
  const PREP_ENABLED = <%- JSON.stringify(prepEnabled) %>;
  const PREP_SECONDS = <%- JSON.stringify(prepSeconds) %>;
  const PREP_LABEL = <%- JSON.stringify(t('dashboard.prep_label')) %>;

  let mode = 'stopwatch'; // 'stopwatch' | 'countdown'
  let phase = 'idle'; // 'idle' | 'prep' | 'active' -- see startPrepPhase/startActivePhase
  let startTime = null;
  let tickHandle = null;
  let autoCompleted = false;
  let running = false;
  let countdownSeconds = TARGET_SECONDS; // editable per-session override, see enableDisplayEdit()
  const display = document.getElementById('timerDisplay');
  const phaseLabel = document.getElementById('timerPhaseLabel');
  const startBtn = document.getElementById('timerStartBtn');
  const stopBtn = document.getElementById('timerStopBtn');
  const modeStopwatchBtn = document.getElementById('modeStopwatchBtn');
  const modeCountdownBtn = document.getElementById('modeCountdownBtn');

  function formatSeconds(totalSeconds) {
    const clamped = Math.max(0, totalSeconds);
    const m = String(Math.floor(clamped / 60)).padStart(2, '0');
    const s = String(clamped % 60).padStart(2, '0');
    return `${m}:${s}`;
  }

  // A clear triple-pulse alarm via Web Audio -- no audio file needed, and it
  // works even if the tab lost focus while counting down in the shower. A
  // square wave at full volume cuts through running water much better than
  // a single soft sine-wave fade.
  function playBeep() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const now = ctx.currentTime;
      [0, 0.22, 0.44].forEach((t) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.type = 'square';
        osc.frequency.value = 1046; // C6 -- cuts through better than a lower tone
        gain.gain.setValueAtTime(0.0001, now + t);
        gain.gain.exponentialRampToValueAtTime(0.35, now + t + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + t + 0.18);
        osc.start(now + t);
        osc.stop(now + t + 0.2);
      });
    } catch {
      // Web Audio unavailable (e.g. autoplay policy) -- the visual "Done!" state still shows.
    }
  }

  function submitLog(durationSeconds) {
    const form = document.createElement('form');
    form.method = 'post';
    form.action = '/log';
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'duration_seconds';
    input.value = durationSeconds;
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }

  function resetButtons() {
    startBtn.disabled = false;
    stopBtn.disabled = true;
  }

  function tick() {
    const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
    if (mode === 'stopwatch') {
      display.textContent = formatSeconds(elapsedSeconds);
      return;
    }
    const remaining = countdownSeconds - elapsedSeconds;
    if (remaining <= 0 && !autoCompleted) {
      autoCompleted = true;
      running = false;
      phase = 'idle';
      clearInterval(tickHandle);
      display.textContent = DONE_TEXT;
      playBeep();
      resetButtons();
      submitLog(countdownSeconds);
      return;
    }
    display.textContent = formatSeconds(remaining);
  }

  // The optional "get ready" phase runs BEFORE the real timer so there's
  // time to step under the shower after tapping Start. A beep marks the
  // handoff into the real cold-shower time, which is what actually gets
  // logged -- prep time itself is never included in the logged duration.
  function prepTick() {
    const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
    const remaining = PREP_SECONDS - elapsedSeconds;
    if (remaining <= 0) {
      clearInterval(tickHandle);
      playBeep();
      startActivePhase();
      return;
    }
    display.textContent = formatSeconds(remaining);
  }

  function startActivePhase() {
    phase = 'active';
    phaseLabel.textContent = '';
    startTime = Date.now();
    autoCompleted = false;
    running = true;
    tickHandle = setInterval(tick, 250);
  }

  function startPrepPhase() {
    phase = 'prep';
    running = true;
    startTime = Date.now();
    phaseLabel.textContent = PREP_LABEL;
    display.textContent = formatSeconds(PREP_SECONDS);
    tickHandle = setInterval(prepTick, 250);
  }

  function setMode(newMode) {
    mode = newMode;
    modeStopwatchBtn.classList.toggle('active', mode === 'stopwatch');
    modeCountdownBtn.classList.toggle('active', mode === 'countdown');
    display.textContent = mode === 'countdown' ? formatSeconds(countdownSeconds) : '00:00';
    display.classList.toggle('editable', mode === 'countdown');
    try {
      localStorage.setItem('coldshowers.mode', mode);
    } catch {
      // Storage unavailable (private browsing, blocked site data) -- mode just won't persist.
    }
  }

  // Tap the display while in countdown mode (and not running) to type a
  // custom duration for the next run -- without going to Settings, which
  // changes the stored default for every future session instead of just
  // this one.
  function enableDisplayEdit() {
    if (mode !== 'countdown' || running) return;
    const input = document.createElement('input');
    input.type = 'text';
    input.inputMode = 'numeric';
    input.className = 'timer-display-input';
    input.value = formatSeconds(countdownSeconds);
    display.replaceWith(input);
    input.focus();
    input.select();

    function commit() {
      const match = input.value.trim().match(/^(\d{1,3}):([0-5]?\d)$/);
      const parsedSeconds = match ? Number(match[1]) * 60 + Number(match[2]) : Number(input.value.trim());
      if (Number.isFinite(parsedSeconds) && parsedSeconds > 0) {
        countdownSeconds = Math.min(3600, Math.round(parsedSeconds));
      }
      input.replaceWith(display);
      display.textContent = formatSeconds(countdownSeconds);
    }

    input.addEventListener('blur', commit);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') input.blur();
    });
  }

  display.addEventListener('click', enableDisplayEdit);

  modeStopwatchBtn.addEventListener('click', () => setMode('stopwatch'));
  modeCountdownBtn.addEventListener('click', () => setMode('countdown'));

  // Restore the last-used mode (stopwatch vs. countdown) on page load.
  try {
    const storedMode = localStorage.getItem('coldshowers.mode');
    if (storedMode === 'countdown') setMode('countdown');
  } catch {
    // Storage unavailable -- default stopwatch mode from the initial markup stands.
  }

  startBtn.addEventListener('click', () => {
    startBtn.disabled = true;
    stopBtn.disabled = false;
    if (PREP_ENABLED) {
      startPrepPhase();
    } else {
      startActivePhase();
    }
  });

  stopBtn.addEventListener('click', () => {
    if (phase === 'prep') {
      // Cancelled during "get ready" -- nothing to log, just reset.
      clearInterval(tickHandle);
      phase = 'idle';
      running = false;
      phaseLabel.textContent = '';
      display.textContent = mode === 'countdown' ? formatSeconds(countdownSeconds) : '00:00';
      resetButtons();
      return;
    }
    if (autoCompleted) return; // already auto-submitted when the countdown hit zero
    clearInterval(tickHandle);
    running = false;
    phase = 'idle';
    const elapsedSeconds = Math.round((Date.now() - startTime) / 1000);
    resetButtons();
    submitLog(elapsedSeconds);
  });
</script>
